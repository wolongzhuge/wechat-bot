# ===== iPad 协议服务端（D:\wechat-ipad-kit 那套，免授权）=====
# 容器里的 Ipad860，basePath 就是 /api，别漏掉
ipad_base_url=http://127.0.0.1:8058/api

# 机器人自己的 wxid（示例留空，必填）这套协议没有「列出已登录账号」的接口，必须手填：
#   wsl.exe -d ubuntu-docker -- docker exec wechat-redis redis-cli -n 2 --scan
# 里面那个 wxid_xxx 就是它（登录态在 Redis DB2）。
ipad_wxid=

# 请求超时(ms)
ipad_timeout=60000

# true 时把每个接口的原始响应写到 data/raw/*.json，第一次跑强烈建议开，用来核对字段名
dump_raw=false

# 轮询间隔(ms)。Msg/Sync 的游标存在服务端登录态里自动回写，客户端不用传 cursor
poll_interval=2000

# ===== 发送限速 =====
# 全局按「平均 send_rate_per_minute 条/分钟」放行，桶里最多攒 send_rate_burst 条，
# 所以几个群同时各回一条能一口气发完（不再被固定间隔串成几秒），持续高频才会被压速。
# 同一个私聊对象 >=private_ms、同一个群 >=group_ms 的最小间隔是风控下限，不动。
# 所有发送仍然排成一条串行队列，任何时刻只有一条在飞。
send_rate_per_minute=40
send_rate_burst=4
send_rate_private_ms=1200
send_rate_group_ms=2200

# ===== 问答（只在私聊生效，群聊已取消 gpt 模式）=====
# 走 Qoder CLI，模型跟着 Qoder 当前配置走，这里不指定 model。
# 没装 CLI 时会回一句明确的失败提示，不会把机器人搞崩。
# 用绝对路径：双击 start-bot.bat 起的进程 PATH 里没有 CLI 安装目录。
# 首次使用先跑一次 qoderclicn login（登录态存在 ~/.qoder-cn）。
qoder_cli_bin=qoderclicn
# 命令行模板，{prompt} 会被整段提示词替换
qoder_cli_args=-p {prompt}
qoder_timeout_ms=180000

# ===== 管理员终端（仅私聊，默认关闭：command/admin/adminIndex.js 里 ENABLED）=====
# 模型名必须和 `qoderclicn --list-models` 完全一致，写错 CLI 会回一句降级警告当回答发出去
admin_default_model=Qwen3.8-Flash
admin_models=Qwen3.8-Flash,DeepSeek-Flash
admin_report_interval_min=10
# 单条 shell 命令超时(ms)
admin_cmd_timeout_ms=60000

# 重置对话的关键字，多个用英文逗号分隔
clear_keywords=清空,再见,早安,午安,晚安

# 默认人设（system prompt）
system_role=

# 私聊开关（true/false）
private=true
# 群聊开关（true/false）
group=true
# 群聊里除 @机器人 之外还能触发的前缀，多个用逗号分隔。
# 斗地主打牌就靠它：群里发「cc334455」等于 @机器人 出牌
trigger_prefix=cc

# ===== 和风天气（可选） =====
weather=false
weather_id=
weather_api_key=
